{
  "manifest_version": 2,
  "name": "Astrea Downloads",
  "version": "0.1.0",
  "description": "Envia o progresso dos downloads para a API local do Astrea.",
  "permissions": ["downloads", "nativeMessaging", "storage"],
  "background": {"scripts": ["config.js", "background.js"], "persistent": true},
  "browser_specific_settings": {
    "gecko": {"id": "downloads@astrea.local", "strict_min_version": "109.0"}
  },
  "incognito": "not_allowed"
}
